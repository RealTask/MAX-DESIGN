{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "MAX-DESIGN reference",
  "version": "1.0.0",
  "description": "Illustrative semantic token structure. Replace sample values with evidence-based values for your product.",
  "color": {
    "primitive": {
      "ink-950": "#111827",
      "ink-700": "#374151",
      "ink-500": "#6B7280",
      "paper-0": "#FFFFFF",
      "paper-50": "#F9FAFB",
      "brand-700": "#1D4ED8",
      "brand-100": "#DBEAFE",
      "green-700": "#15803D",
      "red-700": "#B91C1C",
      "amber-700": "#B45309"
    },
    "semantic": {
      "text-primary": "{color.primitive.ink-950}",
      "text-secondary": "{color.primitive.ink-700}",
      "text-muted": "{color.primitive.ink-500}",
      "surface-page": "{color.primitive.paper-0}",
      "surface-subtle": "{color.primitive.paper-50}",
      "action-primary": "{color.primitive.brand-700}",
      "focus-ring": "{color.primitive.brand-700}",
      "status-success": "{color.primitive.green-700}",
      "status-danger": "{color.primitive.red-700}",
      "status-warning": "{color.primitive.amber-700}"
    }
  },
  "typography": {
    "font-family": {
      "sans": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Consolas, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "display": "clamp(2.25rem, 5vw, 4.5rem)"
    },
    "line-height": {
      "tight": 1.15,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.75rem",
    "lg": "1rem",
    "pill": "999px"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "reduced-motion": "Reduce or remove nonessential movement when prefers-reduced-motion is reduce."
  },
  "guidance": {
    "status": "Example values only; contrast, aliases, and theme completeness must be validated for the target product.",
    "rule": "Use semantic roles in components. Keep primitive values out of one-off component styling unless there is a documented exception."
  }
}
